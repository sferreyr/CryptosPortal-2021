<!DOCTYPE html>
<html>
	<head>


		<meta name="csrf-token" content="{{ csrf_token('ajax_actions') }}">
		<meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1, user-scalable=0">


		<title>
			{% block title %}CryptosPortal
			{% endblock %}
		</title>
		{% block stylesheets %}

			{{ encore_entry_link_tags('app') }}

		{% endblock %}


	</head>

	<header>

		{% block header %}
			<div class="container">

				<img src="{{ asset("img/misc/cryptosportallogo1.png") }}" title="Soon" alt="" width="300em" height="auto">
				

			</div>

		{% endblock %}

	</header>

	{% block nav %}
		{{ include('nav.html.twig') }}
	{% endblock %}
	<body>

		{% block SubNav %}
			{{ include('subnav.html.twig') }}
		{% endblock %}

		{% block body %}

			{#  TOAST MESSAGE FOR UPDATE IN NOTIFICATIONS   THIS WORK IN JAVASCRIPT #}
			<div class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-delay="2000" style="position: fixed; top: 1rem; right: 1rem; z-index:-1;">
				<div class="toast-header">
					<strong class="mr-auto">CryptosPortal</strong>
					<small>Notification</small>
					<button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="toast-body">
					CryptosPortal
				</div>
			</div>

		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
			{{ encore_entry_script_tags('dashboard') }}
			{# FILTERS DROPDOWNS #}


			<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
			<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
			<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

		{% endblock %}

	</body>


	<footer class="new_footer_area bg_color">
		<div class="new_footer_top">
			<div class="container">
				<div class="row">
					<div class="col-lg-3 col-md-6">
						<div class="f_widget company_widget wow fadeInLeft" data-wow-delay="0.2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeInLeft;">
							<h3 class="f-title f_600 t_color f_size_18">Get in Touch</h3>
							<p>Don't miss any updates from the world of cryptocurrencies</p>
							<form action="#" class="f_subscribe_two mailchimp" method="post" novalidate="true" _lpchecked="1">
								<input type="text" name="EMAIL" class="form-control memail" placeholder="Email">
								<button class="btn btn_get btn_get_two" type="submit">Subscribe</button>
								<p class="mchimp-errmessage" style="display: none;"></p>
								<p class="mchimp-sucmessage" style="display: none;"></p>
							</form>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
						<div class="f_widget about-widget pl_70 wow fadeInLeft" data-wow-delay="0.4s" style="visibility: visible; animation-delay: 0.4s; animation-name: fadeInLeft;">
							<h3 class="f-title f_600 t_color f_size_18">Information</h3>
							<ul class="list-unstyled f_list">
								<li>
									<a href="#">Help</a>
								</li>
								<li>
									<a href="#">FAQ</a>
								</li>
								<li>
									<a href="#">Term &amp; conditions</a>
								</li>
								<li>
									<a href="#">Privacy</a>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
						<div class="f_widget about-widget pl_70 wow fadeInLeft" data-wow-delay="0.4s" style="visibility: visible; animation-delay: 0.4s; animation-name: fadeInLeft;">
							<h3 class="f-title f_600 t_color f_size_18">Download CryptosPortal APP</h3>
							<ul class="list-unstyled f_list">

								<li>
									<a href="#"><img src="{{ asset("img/misc/google-play-badge.png") }}" title="Soon" alt="" width="150em" height="auto">
									</a>
								</li>

							</ul>
						</div>

					</div>
					<div class="col-lg-3 col-md-6">
						<h3 class="f-title f_600 t_color f_size_18">Social Networks</h3>
						<div class="f_social_icon">
							<a href="#">
								<i class="fab fa-facebook-square"></i>
							</a>
							<a href="#">
								<i class="fab fa-twitter  "></i>
							</a>
							<a href="#">
								<i class="fab fa-telegram"></i>
							</a>
							<a href="#">
								<i class="fab fa-discord"></i>
							</a>

						</div>

					</div>
				</div>
			</div>
			<div class="footer_bg">
				<div class="footer_bg_one"></div>
				<div class="footer_bg_two"></div>
			</div>
		</div>

	</footer>


</html>
