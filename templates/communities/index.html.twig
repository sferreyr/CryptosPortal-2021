{% extends 'base.html.twig' %}

{% block title %}Hello CommunitiesController!
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('communities') }}
	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
{% endblock %}


{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-sm categoriesList">
				<div class="card" style="width: 16rem;">
					<div class="card-header">
						Crypto Categories Communities
					</div>
					<div class="categoryCryptodrop">
						<label>{{ 'FilterbyCategory'|trans }}</label>

						{{ form_widget(categorydrop.name) }}


					</div>
					<ul class="list-group list-group-flush">


						{% for category in CategoriesList %}

							<li id="{{category.id}}" class="category list-group-item">
								<a href="#">
									<img src="{{ asset(category.photo) }} " title="{{category.name}}" alt="BTC" class="image rounded">
									{{category.name}}
								</a>
							</li>
						{% endfor %}


					</ul>
					{# display navigation #}
					<div class="navigation" style="max-width: 16rem;">
						{{ knp_pagination_render(CategoriesList) }}

					</div>
					{# END display navigation #}
				</div>

			</div>


			<div class="col-sm communitiesList">

				<div class="card" style="width: 36rem;">
					<div class="card-header">
						Crypto Communities Created by Users :=D
					</div>
					<ul class="list-group list-group-flush">
						 <a href="{{path('NewCommunity')}}" <button type="button" style="margin:3px;" class="btn btn-primary">
							<i class="fas fa-plus"></i>
							New Community</button> </a>

						{% for community in CommunitiesList %}
							<a href="{{path('community', {'category':community.categories.id ,'idgroup':community.id }) }}">
								<div class="card" style=" background-image: url('{{community.banner}}'); min-height: 100%; min-width: 100%; background-position: center; ">

									<div class="card-body">
										<img src="{{community.cryptoIcon}}" title="{{ 'Sticky'|trans }}" alt="BTC" class="image rounded">
										<h7>{{community.name}}</h7>

										<small>{{community.description}}</small>

									</div>

								</div>
							</a>

						{% endfor %}

					</ul>
				</div>


			</div>


		</div>


	{% endblock %}

	{% block javascripts %}
		{{ encore_entry_script_tags('app') }}
		{{ encore_entry_script_tags('communities') }}

		<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
		<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
	{% endblock %}
