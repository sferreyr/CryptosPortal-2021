{% extends 'base.html.twig' %}

{% block title %}Hello CommunitiesController!
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('communities') }}
	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
{% endblock %}


{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-sm categoriesList">
				<div class="card" style="width: 50rem;">
					<div class="card-header" style=" background-image: url('../../{{cBanner}}'); min-height: 100%; min-width: 100%; background-position: center; ">

						<h2>Crypto Categories Communities</h2>
						<h3>
							{{cName}}
						</h3>

					</div>
					<form action="{{ path('NewCommunityPost',{'idgroup': CommunityId} )}}" method="post">
						<button type="submit" style="padding:1px;margin:3px; width:auto; height:2em; max-width:8em;" class="btn btn-primary">
							<i class="fas fa-plus"></i>
							New Post</button>
					</form>
					<ul class="list-group list-group-flush">

						<div class="card-body">
							{% for posts in pagination %}
								<li id="" class="category list-group-item">
									<a href="{{path('communityPost', {'category':posts.community.categories.id ,'idgroup':posts.community.id, 'postid':posts.id}) }}">

										<img src="{{posts.community.cryptoIcon}}" title="" alt="BTC" class="image rounded">

										{{posts.title}}
									</a>
								</li>
							{% endfor %}

							{# display navigation #}
							<div class="navigation" style="max-width: 16rem;">
								{{ knp_pagination_render(pagination) }}

							</div>
							{# END display navigation #}


						</div>
					</ul>

				</div>

			</div>

			<div class="col-sm communitiesList">

				<div class="card" style="width: 10rem;">
					<div class="card-header">
						<h5>
							Community Statics
						</h5>
					</div>
					<ul class="list-group list-group-flush">

						<div class="card-body">

							<h6>
								Members: {{cTotalMembers}}
							</h6>
							<h6>
								Publications: {{cTotalPosts}}
							</h6>
							<h6>
								Comments: {{cTotalComments}}
							</h6>
							<h6>
								Reputation:
								{{cReputation}}
							</h6>
							<button>
								Join
							</button>
						</div>


					</ul>
				</div>


			</div>


		</div>


	{% endblock %}

	{% block javascripts %}
		{{ encore_entry_script_tags('app') }}
		{{ encore_entry_script_tags('communities') }}

		<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
		<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
	{% endblock %}
