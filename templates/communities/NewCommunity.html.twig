{% extends 'base.html.twig' %}

{% block title %}Hello CommunitiesController!
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('communities') }}
	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
{% endblock %}


{% block body %}
	<body>


		<div class="container">
			<div class="Vpsbox">
				<div class="col-md-12">
					<div class="viewpostbox">


						<div class="card-header">
							<p>
								<h5>NewPost</h5>
								<b>
									<p>didyouknow</p>
								</b>
								{% for message in app.flashes('success') %}
									<div class="flash-notice">
										{{ message |trans|safe_html }}
									</div>
								{% endfor %}
							</p>
						</div>

						<div class="card-body">
							{{form_start(ncommu) }}


							<div class="col">
								{{ form_row(ncommu.name) }}
								</div>
								
							<div class="row">
								<div class="col-sm">
									<div class="col">{{ 'Categories'|trans }}{{ form_widget(ncommu.categories) }}
									</div>
								</div>

							</div>

							<div class="col">
								{{ form_row(ncommu.description) }}</div>


							<div class="col"></div>

							{# <div class="col">{{ 'Tags'|trans }} {{ form_widget(post.tags) }}</div> #}
							{#<div class="col">{{ 'MainPhoto'|trans }} {{ form_widget(post.main_photo) }}</div>#}

							<div class="col"></div>


							{{	form_end(ncommu)}}
						</div>


					</div>

				</div>
			</div>
		</div>
	</body>
</div></body>
{% endblock %}
{% block javascripts %}
{{ encore_entry_script_tags('app') }}
{{ encore_entry_script_tags('communities') }}

<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script><script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>{% endblock %}
