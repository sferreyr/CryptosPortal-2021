{% extends 'base.html.twig' %}

{% block title %}Hello CommunitiesController!
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('communities') }}
	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
{% endblock %}


{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-sm categoriesList">
				<div class="card" style="width: 50rem;">
					<div class="card-header" style=" background-image: url('{{ asset(" img/misc/block.jpg") }}'); min-height: 100%; min-width: 100%; background-position: center; ">

						<h2>Crypto Categories Communities</h2>

					</div>
					<ul class="list-group list-group-flush">
						<div class="card-header">{{pTitle}}</div>
						{{pOwner.nickname}}
						<div class="card-body">
							{{pContent}}


							{{ pTotalLikes }}
							{{ pTotalPoints}}
							{{ pTotalDislikes }}
							{{ pTotalComments }}
							{{ pCreateAt |date('date.format'|trans)}}
							{{ pIsSticky }}
							{{ pIsFeatured}}


						</div>
					</ul>

				</div>

			</div>

			<div class="col-sm communitiesList">

				<div class="card" style="width: 10rem;">
					<div class="card-header">
						<h5>
							Community Statics
						</h5>
					</div>
					<ul class="list-group list-group-flush">

						<div class="card-body">

							<h6>
								Members: X
							</h6>
							<h6>
								Publications: X
							</h6>
							<h6>
								Comments: X
							</h6>
							<h6>
								Reputation: X
							</h6>
							<button>
								Join
							</button>
						</div>


					</ul>
				</div>


			</div>


		</div>


	{% endblock %}

	{% block javascripts %}
		{{ encore_entry_script_tags('app') }}
		{{ encore_entry_script_tags('communities') }}

		<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
		<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
	{% endblock %}
