{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('myprofile') }}
{% endblock %}

{% block title %}
	Hello OTHER USER!
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-lg-4">
				<div class="profile-card-4 z-depth-3">
					<div class="card">
						<div class="card-body text-center bg-primary rounded-top">
							<div class="user-box">
								<img src="{{ asset('') ~ avatar }}" class="avatar" alt=""/>
							</div>
							<h5 class="mb-1 text-white">
								{{ nickname }}
							</h5>
							<h6 class="text-light">
								{{ avatarTitle.titleName |trans}}
							</h6>
						</div>
						<div class="card-body">
							<ul class="list-group shadow-none">
								<li class="list-group-item">
									<div class="list-icon">

										<img src="{{ asset("img/misc/reputation.png") }}" alt="BTC" class="image rounded">
									</div>
									<div class="list-details">
										<span>{{ Reputation }}</span>
										<small>Reputation</small>
									</div>
								</li>
								<li class="list-group-item">
									<div class="list-icon">
										<img src="{{ asset("img/misc/points.png") }}" alt="BTC" class="image rounded">
									</div>
									<div class="list-details">
										<span>{{ Points }}</span>
										<small>Points</small>
									</div>
								</li>
								<li class="list-group-item">
									<div class="list-icon">
										<img src="{{ asset("img/misc/member.png") }}" alt="BTC" class="image rounded">
									</div>
									<div class="list-details">
										<small>Member Since</small>
										<span>{{ RegisterAt|date('d/m/Y') }}</span>
									</div>
								</li>
							</ul>
							<div class="row text-center mt-4">
								<div class="col p-2">
									<h4 class="mb-1 line-height-5">
										{{totalposts}}
									</h4>
									<small class="mb-0 font-weight-bold">Total Posts</small>
								</div>
								<div class="col p-2">
									<h4 class="mb-1 line-height-5">
										0
									</h4>
									<small class="mb-0 font-weight-bold">Followers</small>
								</div>
								<div class="col p-2">
									<h4 class="mb-1 line-height-5">
										{{totalcomments}}
									</h4>
									<small class="mb-0 font-weight-bold">Total Comments</small>
								</div>
							</div>
						</div>
						<div class="card-footer text-center">
							<a href="javascript:void()" class="btn-social btn-facebook waves-effect waves-light m-1">
								<i class="fa fa-facebook"></i>
							</a>
							<a href="javascript:void()" class="btn-social btn-google-plus waves-effect waves-light m-1">
								<i class="fa fa-google-plus"></i>
							</a>
							<a href="javascript:void()" class="list-inline-item btn-social btn-behance waves-effect waves-light">
								<i class="fa fa-behance"></i>
							</a>
							<a href="javascript:void()" class="list-inline-item btn-social btn-dribbble waves-effect waves-light">
								<i class="fa fa-dribbble"></i>
							</a>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-8">
				<div class="card z-depth-3">
					<div class="card-body">
						<ul class="nav nav-pills nav-pills-primary nav-justified">
							<li class="nav-item">
								<a href="#" class="nav-link active show">
									<i class="icon-user"></i>
									<span class="hidden-xs">Profile</span>
								</a>
							</li>
						</ul>
						<div class="tab-content p-3">
							<div class="tab-pane active show" id="profile">
								<h5 class="mb-3">
									User Profile
								</h5>
								<div class="row">
									<div class="col-md-6">
										<h6>
											<strong>
												About Me</strong>
										</h6>
										<p>
											{{ Aboutme }}
										</p>
									</div>

									<div class="col-md-12">
										<h5 class="mt-2 mb-3">
											<span class="fa fa-clock-o ion-clock float-right"></span>
											Latest 15 Comments
										</h5>
										<table class="table table-hover table-striped">
											<tbody>
												{% for latestcomments in latestcoments %}
													<tr>
														<td>
															<a href="#">
																<strong>{{ latestcomments.user.nickname }}
																</strong>
															</a>
															comento en
															{# <a href="{{ path('viewpost', {ptitle:latestcomments.posts.title}) }}"> #}
															<a href="{{ path( 'viewpost', { category: latestcomments.posts.CategorySlug, ptitle: latestcomments.posts.titleSlug } ) }}">
																<strong>
																	{{ latestcomments.posts.title }}</strong>
															</a>
														</td>
													</tr>
												{% endfor %}
											</tbody>
										</table>
									</div>
								</div>
								<!-- /row -->
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	{% block javascripts %}
		{{ encore_entry_script_tags('myprofile') }}
		<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
		<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
		<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
		<script src="{{ path( 'fos_js_routing_js', { callback: 'fos.Router.setData' } ) }}"></script>
	{% endblock %}
{% endblock %}
