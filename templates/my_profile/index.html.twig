{% extends 'base.html.twig' %}

{% block title %}Hello MyProfileController!
{% endblock %}

{% block body %}


	<div class="container">
		<div class="row">
			<div class="col-md-3 ">
				<div class="list-group ">
					<a href="#" class="list-group-item list-group-item-action active">
						<i class="fas fa-address-card"></i>
						My Basic Info</a>
					<a href="{{ path('my_profileA')}}" class="list-group-item list-group-item-action">
						<i class="fas fa-user-ninja"></i>
						Avatar</a>
					<a href="{{ path('my_profileN')}}" class="list-group-item list-group-item-action">
						<i class="far fa-bell"></i>
						Notifications</a>
					<a href="{{ path('my_profileM')}}" class="list-group-item list-group-item-action">
						<i class="fas fa-inbox"></i>
						<span class="MessagesCountitem">{{ total_messages.GetMessages() }}</span>
						Messages</a>


				</div>
			</div>
			<div class="col-md-9">
				<div class="card">
					<div class="card-body">
						<div class="row">
							<div class="col-md-12">

								<h4>Your Profile</h4>
								<hr>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12">


								{% for message in app.flashes('success') %}
									<div class="alert alert-info alert-dismissible fade show">
										{{ message }}
										<button type="button" class="close" data-dismiss="alert" aria-label="Close">
											<span aria-hidden="true">&times;</span>
										</button>

									</div>
								{% endfor %}


								{{ form_start(form) }}
								<div class="form-group row">
									<label for="text" class="col-4 col-form-label">Nick Name*</label>
									<div class="col-8">
										<div class="col">{{ nickname }}</div>
									</div>
								</div>
								<div class="form-group row">
									<label for="email" class="col-4 col-form-label">Email*</label>
									<div class="col-8">
										<div class="col">{{ email }}</div>
									</div>
								</div>
								<div class="form-group row">
									<label for="name" class="col-4 col-form-label">First Name</label>
									<div
										class="col-8">

										{#<input id="realname" name="realname" value={{realname}} class="form-control here" maxlength="15" minlength="4" type="text"> #}
										{{ form_row(form.rname) }}
									</div>
								</div>
								<div class="form-group row">
									<label for="name" class="col-4 col-form-label">Your Country</label>
									<div class="col-8">
										<div class="col">{{country}}</div>


									</div>
								</div>

								<div class="form-group row">
									<label for="publicinfo" class="col-4 col-form-label">About you ( 300 Words )
									</label>
									<div
										class="col-8">
										{#<textarea id="publicinfo" name="publicinfo" cols="40" rows="4" class="form-control" maxlength="100" minlength="0">{{aboutme}}</textarea> #}
										{{ form_row(form.aboutYou) }}
									</div>
								</div>
								<div class="form-group row">
									<label for="newpass" class="col-4 col-form-label">New Password</label>
									<div class="col-8">
										{{ form_start(formPassword) }}
										{{ form_row(formPassword.password) }}


									</div>
								</div>
								<div class="form-group row">
									<div class="offset-4 col-8">
										{{ form_row(form._token) }}

										<button name="submit" type="submit" class="btn btn-primary">Update My Profile</button>


									</div>
								</div>
								{{ form_end(formPassword) }}
								{{ form_end(form) }}

							</div>
						</div>

					</div>

				</div>
			</div>
		</div>
	</div>


	{% block javascripts %}
		{{ encore_entry_script_tags('app') }}
		{{ encore_entry_script_tags('myprofile') }}

		<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
		<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
	{% endblock %}


{% endblock %}
