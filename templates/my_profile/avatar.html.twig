{% extends 'base.html.twig' %}

{% block title %}
	Hello MyProfileController!
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col-md-3">
				<div class="list-group">
					<a href="{{ path('my_profile') }}" class="list-group-item list-group-item-action">
						<i class="fas fa-address-card"></i>
						My Basic Info
					</a>
					<a href="{{ path('my_profileA') }}" class="list-group-item list-group-item-action active">
						<i class="fas fa-user-ninja"></i>
						Avatar
					</a>
					<a href="{{ path('my_profileN') }}" class="list-group-item list-group-item-action">
						<i class="far fa-bell"></i>
						Notifications
					</a>
						<a href="{{ path('my_profileM')}}" class="list-group-item list-group-item-action">
						<i class="fas fa-inbox"></i>
						<span class="MessagesCountitem">{{ total_messages.GetMessages() }}</span>
						Messages</a>
				</div>
			</div>
			<div class="col-md-9">
				<div class="card">
					<div class="card-body">
						<div class="row">
							<div class="col-md-12">
								<h4>
									Your Avatar
								</h4>
								<hr/>
							</div>
						</div>
						{{ form_start(form) }}
						<div class="row">
							<div class="col-md-12">
								{% for message in app.flashes('success') %}
									<div class="alert alert-info alert-dismissible fade show">
										{{ message }}
										<button type="button" class="close" data-dismiss="alert" aria-label="Close">
											<span aria-hidden="true">&times;</span>
										</button>
									</div>
								{% endfor %}
								<div class="form-group row">
									<label for="email" class="col-4 col-form-label">Avatar</label>
									<div class="col-8">
										<div class="col">
											<img src="{{ asset('') ~ avatar }}" alt="" style="width:150px;height:150px;"/>
											{{ form_row(form.avatar) }}
										</div>
									</div>
								</div>

								{{ form_row(form._token) }}
								<button name="submit" type="submit" class="btn btn-primary">
									Update My Profile
								</button>
								{{ form_end(form) }}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	{% block javascripts %}
		{{ encore_entry_script_tags('app') }}
		{#  {{ encore_entry_script_tags('myprofile') }}
		    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
