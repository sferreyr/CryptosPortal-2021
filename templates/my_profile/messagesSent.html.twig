{% extends 'base.html.twig' %}

{% block title %}
	Hello MyProfileController!
{% endblock %}

{% block body %}

	<div class="container">

		<div class="row">
			<div class="col-md-3">

				<div class="list-group">
					<a href="{{ path('my_profile') }}" class="list-group-item list-group-item-action">
						<i class="fas fa-address-card"></i>
						My Basic Info
					</a>
					<a href="{{ path('my_profileA')}}" class="list-group-item list-group-item-action">
						<i class="fas fa-user-ninja"></i>
						Avatar
					</a>

					<a href="{{ path('my_profileN')}}" class="list-group-item list-group-item-action">
						<i class="far fa-bell"></i>
						Notifications</a>
					<a href="{{ path('my_profileM')}}" class="list-group-item list-group-item-action active">
						<i class="fas fa-inbox"></i><span class="badge badge-primary badge-pill">{{ total_messages.GetMessages() }}</span>
						Messages</a>
				
					<a href="{{ path('my_profileMs')}}" >	<li class="list-group-item d-flex justify-content-between align-items-center">
							Sent Messages
							<span class="MessagesSentCountitem badge badge-primary badge-pill">{{totalSent}}</span>
						</li></a>
					</ul>

				</div>
			</div>
			<div class="col-md-9">

				<div class="col-md-12">
					<h5 class="mt-2 mb-3">
						<i class="fas fa-bell"></i>
						Latest Sent Messages
					</h5>

					<a href="{{ path('my_profileMn')}}">
						<button type="button" class="btn btn-primary" value="{{path('my_profileMn')}}">
							<i class="fas fa-plus"></i>
							New Message</button>
					</a>
					<table class="table table-hover table-striped">
						<tbody>

							{#	{% for message in app.flashes('DelNotification') %} #}
							{#  TOAST MESSAGE FOR UPDATE IN NOTIFICATIONS #}
								<div class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-delay="2000" style="position: absolute; top: 1rem; right: 1rem;"> <div class="toast-header">
									<strong class="mr-auto">CryptosPortal</strong>
									<small>Notification</small>
									<button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
										<span aria-hidden="true">&times;</span>
									</button>
								</div>
								<div class="toast-body">
									You have deleted a message from your sent messages list.
								</div>
							</div>

							{#{% endfor %}#}
							{# If no new notifications. The value change with Javascript#}

                           
							{% for nNotifications in ListMessages %}

								<tr id="{{nNotifications.id}}">
									<td>
										{# <form action="{{path('my_profileND', {'idtodeleted':nNotifications.id}) }}" method="POST"> #}
										<strong>{{nNotifications.sender.nickname}}</strong>
                                           
										{{ 'SentMG'|trans }}
										<a href="{{nNotifications.url}}">
											<strong>
												{{nNotifications.subject}}
											</strong>
										</a>
										<button class="DelSentMessage btn btn-link" id="delete" data-is-like="{{nNotifications.id}}" type="button">
											<i class="far fa-trash-alt"></i>
										</button>
										{# <button class="btn btn-link" name="direction" id="delete"><i class="far fa-trash-alt"></i></button> #}
										{#</form> #}

										{# <a href="{{ path('viewpost', {ptitle:latestcomments.posts.title}) }}"> #}<strong>

									</a>
								</td>
							</tr>


						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>


		{% endblock %}
			{% block javascripts %}
			{{ encore_entry_script_tags('app') }}{{ encore_entry_script_tags('myprofile') }}{{ encore_entry_script_tags('messages') }}<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"> </script>
			<script src="{{ path( 'fos_js_routing_js', { callback: 'fos.Router.setData' } ) }}"></script>
		{% endblock %}
