{% extends 'base.html.twig' %}


{% block title %}
	Hello MyProfileController!
{% endblock %}
{% block stylesheets %}
	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('messages') }}

{% endblock %}

{% block body %}

	<div class="container">
		<div class="row">
			<div class="col-md-3">
				<div class="list-group">
					<a href="{{ path('my_profile') }}" class="list-group-item list-group-item-action">
						<i class="fas fa-address-card"></i>
						My Basic Info
					</a>
					<a href="{{ path('my_profileA')}}" class="list-group-item list-group-item-action">
						<i class="fas fa-user-ninja"></i>
						Avatar
					</a>

					<a href="{{ path('my_profileN')}}" class="list-group-item list-group-item-action">
						<i class="far fa-bell"></i>
						Notifications</a>
					<a href="{{ path('my_profileM')}}" class="list-group-item list-group-item-action active">
						<i class="fas fa-inbox"></i>
						Messages</a>
				</div>
			</div>
			<div class="col-md-9">

				<div class="col-md-12">
					<h5 class="mt-2 mb-3">
						<i class="fas fa-pencil-alt"></i>
						{{ 'NewMessage'|trans }}
					</h5>


					<div class="row">

						<div class="col-md-12">
							{% for message in app.flashes('alert') %}
									<div class="alert alert-info alert-dismissible fade show">
										{{ message }}
										<button type="button" class="close" data-dismiss="alert" aria-label="Close">
											<span aria-hidden="true">&times;</span>
										</button>

									</div>
								{% endfor %}
				  {{ form_start(form) }}
				  {{ ('Recipient'|trans) }}{{ form_widget(form.recipient) }}
				    {{('Subject'|trans) }} {{ form_widget(form.subject) }}

                  
                    {{ form_end(form) }}


						</div>

					</div>
				</div>


			{% endblock %}
			{% block javascripts %}
			
				{{ encore_entry_script_tags('app') }}{{ encore_entry_script_tags('myprofile') }}
			

				{{ encore_entry_script_tags('messages') }}<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
				<script src="{{ path( 'fos_js_routing_js', { callback: 'fos.Router.setData' } ) }}"></script>
			{% endblock %}
