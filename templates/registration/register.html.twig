{% extends 'base.html.twig' %}

{% block title %}Hello RegisterController!
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('accountregl') }}
{% endblock %}


{% block SubNav %}


	{# SUB MENU PARA CREACION DE POST Y INTERACTUAR CON EL MAIN BOARD#}
	<ul class="nav navcenter nav-tabs">
		<li class="nav-item">
			<a href="{{ path('dashboard')}}" class="nav-link">{{ 'Home'|trans }}</a>
		</li>
		<li class="nav-item">
			<a href="{{ path('app_register')}}" class="nav-link active">{{ 'Register'|trans }}</a>
		</li>
		<li class="nav-item">
			<a href="{{ path('app_login')}}" class="nav-link">{{ 'Login'|trans }}</a>
		</li>
	</ul>
	{# END SUB MENU PARA CREACION DE POST Y INTERACTUAR CON EL MAIN BOARD#}


{% endblock %}




{% block body %}


	<div class="container">
		<div class="rowLogin">
			<div class="col-sm-9 col-md-7 col-lg-5 mx-auto">
				<div class="card card-signin my-5">
					<div class="card-body">


						{% for message in app.flashes('success') %}
							<div class="alert alert-success">
								{{ message }}
							</div>
						{% endfor %}

						{% if app.user %}
							<div class="mb-3">
								You are logged in as
								{{ app.user.username }},
								<a href="{{ path('app_logout') }}">Logout</a>
							</div>
						{% endif %}


						<div class="signup-form">
							{{ form_start(registrationForm) }}
							<h2>Register</h2>
							<b><p class="hint-text">Create your account. It's free and only takes a minute.</p></b>
							<div class="form-group">
								<div class="col">{{ form_label(registrationForm.rname) }}
									{{ form_widget(registrationForm.rname) }}</div>
								<div class="col">{{ form_label(registrationForm.nickname) }} {{ form_widget(registrationForm.nickname) }}
									{% for message in app.flashes('nickname') %}
										<div class="alert alert-info alert-dismissible fade show">
											{{ (message) }}
											<button type="button" class="close" data-dismiss="alert" aria-label="Close">
												<span aria-hidden="true">&times;</span>
											</button>
										</div>
									{% endfor %}
								</div>
								<div class="col">{{ form_label(registrationForm.country) }}{{ form_widget(registrationForm.country) }}</div>
								<div class="col">{{ form_label(registrationForm.birthdate) }}{{ form_widget(registrationForm.birthdate) }}</div>

							</div>
							<div class="form-group">

								<div class="col">{{ form_label(registrationForm.email) }}{{ form_widget(registrationForm.email) }}
									{% for message in app.flashes('email') %}
										<div class="alert alert-info alert-dismissible fade show">
											{{ message }}
											<button type="button" class="close" data-dismiss="alert" aria-label="Close">
												<span aria-hidden="true">&times;</span>
											</button>

										</div>
									{% endfor %}
								</div>
								{#<div class="col">{{ form_label(form.avatartitle) }}{{ form_widget(form.avatartitle) }}</div> #}
							</div>

							<div class="form-group">

								<div class="col">{{ form_widget(registrationForm.password) }}</div>
								
							</div>

							<div class="form-group">

								<div class="col">{{ form_row(registrationForm.captcha) }}</div>
							</div>


							<div class="form-group">

								<label class="form-check-label">
									{{form_row(registrationForm.agreeTerms)}}
									
									I accept the 
									&nbsp;
									<a href="#">Terms of Use</a>
									&nbsp;
									&amp;
									&nbsp;
									<a href="#"> Privacy Policy</a>
								</label>

							</div>
							<div class="form-group">
								<button type="submit" class="btn btn-success btn-lg btn-block">Register Now</button>
							</div>

							<div class="text-center">Already have an account?
								<a href="{{ path('app_login')}}">Sign in</a>
							</div>
							{{ form_end(registrationForm) }}


						</div>


					</div>
				</div>
			</div>
		</div>
	</div>


{% endblock %}

{% block javascripts %}
	{{ encore_entry_script_tags('app') }}
	{{ encore_entry_script_tags('accountregl') }}

	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
	<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
	<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
{% endblock %}
