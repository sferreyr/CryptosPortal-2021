{% extends 'base.html.twig' %}


{% block title %}
	DashBoard CryptosPortal
	{{parent()}}
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('newpost') }}

{% endblock %}




{%block SubNav %}

	{# SUB MENU PARA CREACION DE POST Y INTERACTUAR CON EL MAIN BOARD#}
	<ul class="nav navcenter nav-tabs">
		<li class="nav-item">
			<a href="{{ path('dashboard')}}" class="nav-link ">{{ 'Home'|trans }}</a>
		</li>
		<li class="nav-item">
			<a href="{{ path('newpost')}}" class="nav-link active">{{ 'New Post'|trans }}</a>
		</li>
	</ul>
	{# END SUB MENU PARA CREACION DE POST Y INTERACTUAR CON EL MAIN BOARD#}


{% endblock %}


{% block body %}
	{{parent()}}




	<body>


		<div class="container">
			<div class="Vpsbox">
				<div class="col-md-12">
					<div class="viewpostbox">


						<div class="card-header">
							<p>
								<h5>{{NewPost}}</h5>
								<b><p>{{didyouknow}}:</p></b>
								{% for message in app.flashes('success') %}
   								 <div class="flash-notice">
{{ message |trans|safe_html }}
   								 </div>
									{% endfor %}
							</p>
						</div>

						<div class="card-body">
							{{ form_start(post) }}


							<div class="col">{{ 'Title'|trans }}{{ form_widget(post.title) }}</div>
							<div class="row">
								<div class="col-sm">
									<div class="col">{{ 'Categories'|trans }}
										{{ form_widget(post.categories) }}</div>
								</div>
								<div class="col-sm">
									<div class="col">{{ 'LangCategories'|trans }}
										{{ form_widget(post.langcategories) }}</div>
								</div>
								<div class="col-sm">
									<div class="col">{{ 'SubCategories'|trans }}
										{{ form_widget(post.subcategories) }}</div>
								</div>
							</div>

							<div class="col">
								 {{ form_row(post.content) }} </div>






							<div class="col"> {{ form_row(post.captcha) }}</div>

							{# <div class="col">{{ 'Tags'|trans }} {{ form_widget(post.tags) }}</div> #}
							{#<div class="col">{{ 'MainPhoto'|trans }} {{ form_widget(post.main_photo) }}</div>#}

							<div class="col">{{ form_widget(post.submit) }}</div>


							{{ form_end(post) }}
						</div>


					</div>

				</div>
			</div>
		</div>

</div></body>{% endblock %}

{% block javascripts %}
{{ encore_entry_script_tags('app') }}{{ encore_entry_script_tags('newpost') }}

	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
	<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
	<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
{% endblock %}
