{% extends 'base.html.twig' %}

{% block title %}Hello RegisterController!
{% endblock %}
{% block stylesheets %}

	{{ encore_entry_link_tags('app') }}
	{{ encore_entry_link_tags('accountregl') }}
{% endblock %}

{% block SubNav %}


	{# SUB MENU PARA CREACION DE POST Y INTERACTUAR CON EL MAIN BOARD#}
	<ul class="nav navcenter nav-tabs">
		<li class="nav-item">
			<a href="{{ path('dashboard')}}" class="nav-link">{{ 'Home'|trans }}</a>
		</li>
		<li class="nav-item">
			<a href="{{ path('app_register')}}" class="nav-link">{{ 'Register'|trans }}</a>
		</li>
		<li class="nav-item">
			<a href="{{ path('app_login')}}" class="nav-link active">{{ 'Login'|trans }}</a>
		</li>
	</ul>
	{# END SUB MENU PARA CREACION DE POST Y INTERACTUAR CON EL MAIN BOARD#}


{% endblock %}
{% block body %}


	<div class="container">
		<div class="rowLogin">
			<div class="col-sm-9 col-md-7 col-lg-5 mx-auto">
				<div class="card card-signin my-5">
					<div class="card-body">
						<h5 class="card-title text-center">Sign In</h5>

						{% if error %}
							<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
						{% endif %}

						{% if app.user %}
							<div class="mb-3">
								You are logged in as
								{{ app.user.username }},
								<a href="{{ path('app_logout') }}">Logout</a>
							</div>
						{% endif %}

						<form  method="post">

							<div class="form-label-group">

								<input type="email"  name="email" id="inputEmail" class="form-control" placeholder="Email address" required autofocus>
								<label for="inputEmail">Email address</label>
							</div>

							<div class="form-label-group">
								<input type="password" name="password"   id="inputPassword" class="form-control" placeholder="Password" required>
								<label for="inputPassword">Password</label>
							</div>

							<div class="custom-control custom-checkbox mb-3">
								<input type="checkbox" class="custom-control-input" id="customCheck1">
								<label class="custom-control-label" for="customCheck1">Remember password</label>
							</div>

							<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

							<button class="btn btn-lg btn-primary btn-block text-uppercase" type="submit">Sign in</button>

							<hr class="my-4">
							<button class="btn btn-lg btn-google btn-block text-uppercase" type="submit">
								<i class="fab fa-google mr-2"></i>
								Sign in with Google</button>
							<button class="btn btn-lg btn-facebook btn-block text-uppercase" type="submit">
								<i class="fab fa-facebook-f mr-2"></i>
								Sign in with Facebook</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>


{% endblock %}

{% block javascripts %}
	{{ encore_entry_script_tags('app') }}
	{{ encore_entry_script_tags('accountregl') }}

	<script src="//www.google.com/recaptcha/api.js?hl={{ app.request.locale }}"></script>
	<script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
	<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
{% endblock %}
